{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Ishibashiri: Check environment",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Check"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    },
    {
      "label": "Ishibashiri: Build Editor",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Build"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Setup map and build",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Setup"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Play",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Play"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Open Unreal Editor",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Editor"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Play campaign",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Play", "-Campaign"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Test route climbing",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Test", "-Climbing", "-TestFPS", "60"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": { "kind": "test", "isDefault": true },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Test camera (current arena)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Test", "-Camera", "-Capture", "-SkipBuild", "-TestFPS", "60"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Test approach chapter",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Test", "-Approach", "-SkipBuild", "-TestFPS", "60"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Test campaign E2E",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Test", "-Campaign", "-SkipBuild", "-TestFPS", "60"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Test combat",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Test"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Test full playthrough",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Test", "-Playthrough"],
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Run review gate (evidence bundle)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/RunIshibashiriReviewGate.ps1"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Python source-contract tests",
      "type": "shell",
      "command": "python -m pytest -q Tests",
      "options": { "cwd": "${workspaceFolder}" },
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "Ishibashiri: Generate C++ completion database",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "CodeDatabase"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    },
    {
      "label": "Ishibashiri: Package Windows",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Tools/Prototype.ps1", "-Action", "Package"],
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": ["$msCompile"]
    }
  ]
}
